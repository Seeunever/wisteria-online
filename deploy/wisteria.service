[Unit]
Description=Wisteria Online
After=network.target

[Service]
Type=simple
User=wisteria
Group=wisteria
UMask=0077
WorkingDirectory=/opt/wisteria/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3210
Environment=WISTERIA_DATA_DIR=/var/lib/wisteria
ExecStart=/usr/bin/node /opt/wisteria/current/.next/standalone/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wisteria
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
