# Copy to .env.production and fill values after choosing the server and domain.
# Node 24: node --env-file=.env.production server.mjs
APP_MODE=production
TEST_ASSIST=0
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=https://your-domain.example
SITE_ACCESS_CODE=
# Absolute paths outside the code directory, on persistent storage.
# Replace with Linux paths if deploying on Linux.
STATE_DIR=E:/WisteriaData/production
BACKUP_DIR=E:/WisteriaData/backups
